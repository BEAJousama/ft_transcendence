# Example backend env file
# Copy to backend/.env or root backend.env (docker-compose uses root backend.env)

DATABASE_URL=postgresql://postgres:postgres@db:5432/ft_transcendence?schema=public
JWT_SECRET=replace_with_a_secure_random_value
TFA_JWT_SECRET=replace_with_a_secure_random_value
FRONTEND_URL=http://localhost:5001
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret
FORTYTWO_CALLBACK_URL=http://localhost:3000/auth/42/redirect
PORT=3000
CHAT_METRICS_ENABLED=false
