# Example frontend env file
# Copy to frontend/.env.local or root frontend.env (docker-compose uses root frontend.env)

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5001

# Variables consumed directly by frontend code (next.config exposes these)
NEXT_PUBLIC_BACK_END_URL=http://localhost:3000/
NEXT_PUBLIC_FRONT_END_URL=http://localhost:5001
NEXT_PUBLIC_CHAT_V2_ENABLED=false
