# Copy this file to .env.oracle on the Oracle VM and replace every placeholder.
POSTGRES_USER=ft_transcendence
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=ft_transcendence
DATABASE_URL_UNPOOLED=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5434/${POSTGRES_DB}?schema=public

JWT_SECRET=replace_with_a_long_random_secret
TFA_JWT_SECRET=replace_with_a_different_long_random_secret
FRONTEND_URL=https://pongmasters.obeaj.me
NEXT_PUBLIC_API_URL=https://pongmastersapi.obeaj.me
NEXT_PUBLIC_WS_URL=wss://pongmastersapi.obeaj.me
NEXT_PUBLIC_FRONTEND_URL=https://pongmasters.obeaj.me
NEXT_PUBLIC_BACK_END_URL=https://pongmastersapi.obeaj.me/
NEXT_PUBLIC_FRONT_END_URL=https://pongmasters.obeaj.me
NEXT_PUBLIC_CHAT_V2_ENABLED=true

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=https://pongmastersapi.obeaj.me/api/auth/google/callback
FORTYTWO_CLIENT_ID=replace_with_42_client_id
FORTYTWO_CLIENT_SECRET=replace_with_42_client_secret
FORTYTWO_CALLBACK_URL=https://pongmastersapi.obeaj.me/api/auth/42/callback
PORT=3000
CHAT_METRICS_ENABLED=false